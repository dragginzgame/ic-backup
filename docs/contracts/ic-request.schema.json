      {
        "method": "stop_canister",
        "target": "renrk-eyaaa-aaaaa-aaada-cai",
        "snapshot_id": null,
        "arguments_hex": "4449444c016c01b3c4b1f204680100010a00000000000000060101",
        "digest": "03e7008814fef428ea4a1bb4ffebc8e02aa99e770ef5cc193cf93e5c9b5ebfa7"
      },
      {
        "method": "take_canister_snapshot",
        "target": "renrk-eyaaa-aaaaa-aaada-cai",
        "snapshot_id": null,
        "arguments_hex": "4449444c056c04efc1e4cf0101b3c4b1f20468eabb9ad30903ca9998b40d046e026d7b6e7e6e78010000010a00000000000000060101010000",
        "digest": "5748517eed542c48b62534fe4d025d8649426eb75ae0ab3894434adc30a04075"
      }
    ],
    "golden-source": "Independent Python field-ID hashing, unsigned/signed LEB128 and direct Candid type/value construction from published argument definitions; no Rust production or Candid encoder invoked."
  },
  "examples": [
    {
      "version": 1,
      "method": "canister_status",
      "target": "renrk-eyaaa-aaaaa-aaada-cai",
      "snapshot_id": null
    },
    {
      "version": 1,
      "method": "list_canister_snapshots",
      "target": "renrk-eyaaa-aaaaa-aaada-cai",
      "snapshot_id": null
    },
    {
      "version": 1,
      "method": "load_canister_snapshot",
      "target": "renrk-eyaaa-aaaaa-aaada-cai",
      "snapshot_id": [
        0,
        255,
        17
      ]
    },
    {
      "version": 1,
      "method": "start_canister",
      "target": "renrk-eyaaa-aaaaa-aaada-cai",
      "snapshot_id": null
    },
    {
      "version": 1,
      "method": "stop_canister",
      "target": "renrk-eyaaa-aaaaa-aaada-cai",
      "snapshot_id": null
    },
    {
      "version": 1,
      "method": "take_canister_snapshot",
      "target": "renrk-eyaaa-aaaaa-aaada-cai",
      "snapshot_id": null
    }
  ]
}
