{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ic-backup v1 declared physical inventory",
  "description": "A bounded closed parent forest of exact physical identities. Runtime verifies canonical principal/hash admission, unique normalized principals, closed parent edges and absence of cycles. Multiple disconnected roots are allowed; declarations and hashes establish no fresh live membership, authority, application fencing or consistency. Duplicate JSON fields reject at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "targets"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "x-unique-key": "canonical canister_id",
      "x-canonical-order": "canonical canister_id ASCII text",
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "x-max-encoded-bytes": 1048576,
  "x-max-canonical-output-bytes": 1048576,
  "x-runtime-max-parent-depth": 1023,
  "x-canonical-digest": {
    "algorithm": "sha256",
    "encoding": [
      "ASCII ic-backup/inventory/v1 followed by one zero byte",
      "Canonical sorted target count: unsigned u32 big-endian",
      "Each target in canonical canister_id ASCII order: canister_id encoded as unsigned u32 big-endian UTF-8 byte length followed by text bytes",
      "For each target, parent_canister_id then role then module_hash: null is byte 0; present text is byte 1 followed by unsigned u32 big-endian UTF-8 byte length and text bytes",
      "Normalize principals and SHA-256 hashes at admission; role UTF-8 bytes remain exact"
    ],
    "excluded": [
      "version (fixed by domain)",
      "JSON formatting",
      "live membership/authority evidence",
      "selection projections"
    ],
    "golden-vectors": [
      {
        "record": {
          "version": 1,
          "targets": [
            {
              "canister_id": "aaaaa-aa",
              "parent_canister_id": null,
              "role": null,
              "module_hash": null
            }
          ]
        },
        "sha256": "637c4054fa40a834193b0616a3153e4152bfa9b87ffc50406e8f2801b2f3f819"
      },
      {
        "record": {
          "version": 1,
          "targets": [
            {
              "canister_id": "aaaaa-aa",
              "parent_canister_id": null,
              "role": "root",
              "module_hash": null
            },
            {
              "canister_id": "renrk-eyaaa-aaaaa-aaada-cai",
              "parent_canister_id": "aaaaa-aa",
              "role": "app",
              "module_hash": "abababababababababababababababababababababababababababababababab"
            },
            {
              "canister_id": "rno2w-sqaaa-aaaaa-aaacq-cai",
              "parent_canister_id": "renrk-eyaaa-aaaaa-aaada-cai",
              "role": null,
              "module_hash": null
            }
          ]
        },
        "sha256": "e8d4ca96f6c9e13b79cafb3e8bc76a985f5d8dc43958aad77cfcbc713fa027cd"
      }
    ]
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canister_id",
        "parent_canister_id",
        "role",
        "module_hash"
      ],
      "properties": {
        "canister_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 63,
          "pattern": "^[a-zA-Z2-7]{5}(?:-[a-zA-Z2-7]{5})*(?:-[a-zA-Z2-7]{1,5})?$",
          "description": "Runtime checks principal checksum/grouping and emits canonical lowercase ASCII."
        },
        "parent_canister_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 8,
              "maxLength": 63,
              "pattern": "^[a-zA-Z2-7]{5}(?:-[a-zA-Z2-7]{5})*(?:-[a-zA-Z2-7]{1,5})?$",
              "description": "Runtime checks principal checksum/grouping and emits canonical lowercase ASCII."
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 256,
              "x-max-utf8-bytes": 256,
              "description": "Runtime bounds UTF-8 bytes to 256. Opaque integration label; null, empty and literal null are distinct."
            },
            {
              "type": "null"
            }
          ]
        },
        "module_hash": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9A-Fa-f]{64}$",
              "description": "Runtime normalizes exact SHA-256 text to lowercase."
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "targets": [
        {
          "canister_id": "aaaaa-aa",
          "parent_canister_id": null,
          "role": null,
          "module_hash": null
        }
      ]
    },
    {
      "version": 1,
      "targets": [
        {
          "canister_id": "aaaaa-aa",
          "parent_canister_id": null,
          "role": "root",
          "module_hash": null
        },
        {
          "canister_id": "renrk-eyaaa-aaaaa-aaada-cai",
          "parent_canister_id": "aaaaa-aa",
          "role": "app",
          "module_hash": "abababababababababababababababababababababababababababababababab"
        },
        {
          "canister_id": "rno2w-sqaaa-aaaaa-aaacq-cai",
          "parent_canister_id": "renrk-eyaaa-aaaaa-aaada-cai",
          "role": null,
          "module_hash": null
        }
      ]
    }
  ]
}
