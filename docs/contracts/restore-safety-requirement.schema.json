            "algorithm" : {
               "const" : "sha256"
            },
            "hash" : {
               "maxLength" : 64,
               "minLength" : 64,
               "pattern" : "^[0-9a-fA-F]{64}$",
               "type" : "string"
            }
         },
         "required" : [
            "algorithm",
            "hash"
         ],
         "type" : "object"
      },
      "fence" : {
