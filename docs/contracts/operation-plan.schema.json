            "role": null,
            "module_hash": null
          }
        ]
      },
      "selected_targets": [
        "renrk-eyaaa-aaaaa-aaada-cai"
      ],
      "graph": {
        "version": 1,
        "nodes": [
          {
            "operation_sequence": 0,
            "depends_on": []
          },
          {
